direction: down
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}

offchain: "Off-chain" {
  direction: right
  style.fill: "#f8fafc"
  style.stroke: "#cbd5e1"
  style.font-size: 14
  n6: "Issuer bank account" {shape: cylinder; style.font-size: 13; style.fill: "#ffffff"}
  n9: "Manager" {shape: rectangle; style.font-size: 13; style.fill: "#ffffff"}
  n10: "Credit fund" {shape: rectangle; style.font-size: 13; style.fill: "#ffffff"}
  n11: "Warehouse SPV" {shape: rectangle; style.font-size: 13; style.fill: "#ffffff"}
  n12: "Equipment lessor" {shape: rectangle; style.font-size: 13; style.fill: "#ffffff"}
}

onchain: "On-chain" {
  direction: right
  style.fill: "#f8fafc"
  style.stroke: "#cbd5e1"
  style.font-size: 14
  n1: "Investor wallet" {shape: person; style.font-size: 13; style.fill: "#ffffff"}
  n2: "aSN token" {shape: rectangle; style.border-radius: 8; style.font-size: 13; style.fill: "#ffffff"}
}

offchain.n12 -> offchain.n11: "lease collections [S]" {style.stroke: "#16a34a"; style.font-size: 12; style.opacity: 0.7}
offchain.n11 -> offchain.n10: "note repayments [U]" {style.stroke: "#16a34a"; style.font-size: 12; style.opacity: 0.5}
offchain.n10 -> offchain.n6: "fund distributions [S]" {style.stroke: "#16a34a"; style.font-size: 12; style.opacity: 0.7}
offchain.n6 -> offchain.n9: "management fee [S]" {style.stroke: "#6b7280"; style.font-size: 12; style.stroke-dash: 2; style.opacity: 0.7}
onchain.n2 -> onchain.n1: "aSN burned on redemption [C]" {style.stroke: "#2563eb"; style.font-size: 12; style.stroke-dash: 5}
